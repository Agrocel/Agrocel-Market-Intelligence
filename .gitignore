# ==============================================================================
# Agrocel Market Intelligence - Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATA & DATASETS (Confidential & Raw Data)
# ------------------------------------------------------------------------------
# Ignore all contents of Data / data directories
/[dD]ata/*
!/[dD]ata/.gitkeep
!/[dD]ata/documents/
/[dD]ata/documents/*
!/[dD]ata/documents/.gitkeep
!/[dD]ata/Raw/
/[dD]ata/Raw/*
!/[dD]ata/Raw/.gitkeep
!/[dD]ata/sample/
/[dD]ata/sample/*
!/[dD]ata/sample/.gitkeep
!/[dD]ata/qdrant_storage/
/[dD]ata/qdrant_storage/*
!/[dD]ata/qdrant_storage/.gitkeep

# All tabular, binary & raw data files anywhere in the project
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.jsonl
*.ndjson

# ETL rejected rows & generated report data exports
reports/*.csv
reports/*.xlsx
reports/*.pdf
backend/reports/*
!backend/reports/.gitkeep

# ------------------------------------------------------------------------------
# 2. DATABASES & VECTOR STORES
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.sql.dump
backend/agrocel_mi.db
**/qdrant_storage/
qdrant_storage/
.lock

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT VARIABLES & SECRETS
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
!.env.example
backend/.env
frontend/.env
*.pem
*.key
*.cert
*.crt
credentials.json
service_account*.json

# ------------------------------------------------------------------------------
# 4. PYTHON (Artifacts, Caches & Virtual Environments)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, Coverage & Quality Tools
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# ------------------------------------------------------------------------------
# 5. FRONTEND & NODE
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.vite/
frontend/.vite/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. OPERATING SYSTEM & EDITORS
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDEs & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. LOGS & TEMPORARY FILES
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
